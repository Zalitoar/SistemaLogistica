@startuml
scale max 1600 width
title TD-05 — Controlar cumplimiento de viaje — Diseño de implementación
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox
autonumber

actor "Planificador de Tráfico" as ACT
participant "[Presentación]\nFrmCumplimientoViaje" as UI
participant "[BLL]\nGestorCumplimiento" as BLL
participant "[BLL]\nReglasTD" as RULES
participant "[Servicios]\nSessionManager" as SES
participant "[DAL]\nMP_Entrega / MP_Viaje" as DAL
database "[SQL Server]\nSistemaLogistica" as DB
participant "[Servicios]\nBitacoraManager" as BIT

ACT -> UI : seleccionar viaje para control
UI -> BLL : Analizar(idViaje)
BLL -> RULES : validar permiso
RULES -> SES : TienePermiso("TD_CONTROLAR_CUMPLIMIENTO")
SES --> RULES : autorizado / denegado
BLL -> DAL : obtener viaje y entregas
DAL -> DB : consultar resultados del viaje
DB --> DAL : viaje + entregas
DAL --> BLL : datos de cumplimiento
BLL -> BLL : Calcular(viaje, entregas)
BLL --> UI : CumplimientoViaje

ACT -> UI : confirmar cierre
UI -> BLL : Cerrar(idViaje)

alt todas las entregas tienen resultado
  BLL -> DAL : Cerrar(idViaje)
  DAL -> DB : cerrar viaje y porcentaje\n(procedimiento TD_CERRAR_VIAJE)
  DB --> DAL : viaje Cerrado
  DAL --> BLL : operación confirmada
  BLL -> BIT : Registrar("TD: viaje cerrado")
  BLL --> UI : cierre confirmado
  UI --> ACT : resultado final
else existen entregas pendientes
  BLL --> UI : cierre rechazado
  UI --> ACT : completar resultados pendientes
end
@enduml
