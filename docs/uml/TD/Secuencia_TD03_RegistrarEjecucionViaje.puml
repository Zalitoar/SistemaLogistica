@startuml
scale max 1600 width
title TD-03 — Registrar ejecución de viaje — Diseño de implementación
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox
autonumber

actor "Operador de Transporte" as ACT
participant "[Presentación]\nFrmEjecucionViaje" as UI
participant "[BLL]\nGestorViaje" as BLL
participant "[BLL]\nReglasTD" as RULES
participant "[Servicios]\nSessionManager" as SES
participant "[DAL]\nMP_Viaje" as DAL
database "[SQL Server]\nSistemaLogistica" as DB
participant "[Servicios]\nBitacoraManager" as BIT

ACT -> UI : seleccionar viaje preparado
UI -> BLL : ObtenerViajes()
BLL -> DAL : Listar()
DAL -> DB : consultar viajes habilitados
DB --> DAL : viajes
DAL --> BLL : viajes
BLL --> UI : viajes

ACT -> UI : confirmar inicio
UI -> BLL : Iniciar(idViaje)
BLL -> RULES : validar permiso y condiciones de inicio
RULES -> SES : TienePermiso("TD_EJECUTAR_VIAJE")
SES --> RULES : autorizado / denegado

alt viaje habilitado
  BLL -> DAL : Iniciar(idViaje)
  DAL -> DB : iniciar viaje\n(procedimiento TD_INICIAR_VIAJE)
  DB --> DAL : viaje EnCurso
  DAL --> BLL : operación confirmada
  BLL -> BIT : Registrar("TD: viaje iniciado")
  BLL --> UI : viaje iniciado
  UI --> ACT : ejecución habilitada
else viaje no habilitado
  RULES --> BLL : ReglaTDException
  BLL --> UI : informar causa
  UI --> ACT : inicio rechazado
end
@enduml
